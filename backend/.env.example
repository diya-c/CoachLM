# ============================================================
# CoachLM Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# MySQL Database Connection
# Format: mysql+pymysql://username:password@host/database_name
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost/coachlm_db

# JWT Secret Key — change this to a long random string in production
JWT_SECRET_KEY=change-this-to-a-very-long-random-secret-key

# LLM Provider: "groq" (free, fast) or "openai"
LLM_PROVIDER=groq

# Groq API Key — get free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key — only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# Number of questions per interview session
QUESTIONS_PER_SESSION=5

# Allowed frontend origin for CORS
CORS_ORIGINS=http://localhost:5173
